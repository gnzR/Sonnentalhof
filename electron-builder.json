{
  "appId": "de.sonnental.hof",
  "productName": "Sonnental Hof",
  "copyright": "Copyright © 2026 w33derlich",
  "compression": "store",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "!dist/assets/aistudio/**/*",
    "electron/**/*"
  ],
  "win": {
    "icon": "electron/icon.png",
    "requestedExecutionLevel": "asInvoker",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Sonnental-Hof-Setup-Beta-1.1-win-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sonnental Hof"
  },
  "linux": {
    "icon": "electron/icon.png",
    "target": [
      "tar.gz"
    ],
    "artifactName": "Sonnental-Hof-Beta-1.1-linux-x64.${ext}",
    "category": "Game",
    "executableName": "sonnental-hof"
  }
}
